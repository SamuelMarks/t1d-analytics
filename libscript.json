{
  "domain": "t1d-analytics.healthplatform.io",
  "infrastructure": {
    "node": {
      "size": "Standard_D16s_v7",
      "data_disks": [
        {
          "size_gb": 100,
          "mount_path": "/mnt/data",
          "name": "data-disk"
        }
      ]
    },
    "network": {
      "ports": ["22", "80", "443"]
    }
  },
  "ingress": {
    "tls": "letsencrypt",
    "port": 3000
  },
  "hooks": {
    "install": [
      "sudo mkdir -p /mnt/data",
      "sudo mount /dev/nvme1n1 /mnt/data || sudo mount /dev/disk/azure/scsi1/lun0 /mnt/data || true",
      "/home/azureuser/.local/bin/uv sync",
      "(cd web && export PATH=/home/azureuser/.volta/bin:$PATH && npm install)",
      "sudo apt-get update && sudo apt-get install -y certbot python3-certbot-nginx",
      "printf 'server { listen 80; server_name t1d-analytics.healthplatform.io; proxy_read_timeout 3600; proxy_connect_timeout 3600; proxy_send_timeout 3600; location / { proxy_pass http://127.0.0.1:3000; } location /api/ { proxy_pass http://127.0.0.1:8001; } }' | sudo tee /etc/nginx/conf.d/t1d-analytics.healthplatform.io.conf",
      "sudo systemctl restart nginx || true",
      "sudo certbot --nginx -n --agree-tos -d t1d-analytics.healthplatform.io -m admin@healthplatform.io --redirect || true"
    ],
    "build": [
      "(cd web && export PATH=/home/azureuser/.volta/bin:$PATH && npm run build)"
    ],
    "pre_start": ["sudo -u postgres createdb t1d_analytics || true"]
  },
  "services": {
    "t1d-api": {
      "command": "/home/azureuser/.local/bin/uv run uvicorn t1d_analytics.api:app --host 0.0.0.0 --port 8001",
      "env": {
        "DATABASE_URL": "postgres://postgres:password@127.0.0.1:5432/t1d_analytics",
        "T1D_DB_PATH": "/mnt/data/t1d_analytics.duckdb"
      }
    },
    "t1d-web": {
      "command": "cd web && export PATH=/home/azureuser/.volta/bin:$PATH && npx vite preview --port 3000 --host",
      "env": {
        "NODE_ENV": "production",
        "DATABASE_URL": "postgres://postgres:password@127.0.0.1:5432/t1d_analytics"
      }
    }
  },
  "dependencies": {
    "required": {
      "databases": [
        {
          "name": "postgres",
          "version": "latest",
          "env": "DATABASE_URL",
          "vars": {
            "database_name": "t1d_analytics"
          }
        }
      ],
      "servers": [
        {
          "name": "nginx",
          "daemon": {
            "os_native": true
          },
          "vars": {
            "NGINX_SERVER_NAME": "t1d-analytics.healthplatform.io",
            "PROXY_PASS": "http://127.0.0.1:3000",
            "LOCATION": "/"
          }
        }
      ],
      "toolchains": [
        {
          "name": "nodejs",
          "version": "20.x"
        },
        {
          "name": "python",
          "version": "3.11"
        },
        {
          "name": "duckdb",
          "version": "latest"
        },
        {
          "name": "ollama",
          "version": "latest"
        }
      ],
      "capabilities": ["systemd"]
    }
  }
}
