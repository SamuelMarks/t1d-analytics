{
  "domain": "t1d-analytics.healthplatform.io",
  "infrastructure": {
    "node": {
      "size": "Standard_D16s_v7",
      "data_disks": [
        {
          "size_gb": 100,
          "mount_path": "/mnt/data",
          "name": "data-disk"
        }
      ]
    },
    "network": {
      "ports": ["22", "80", "443"]
    }
  },
  "ingress": {
    "tls": "letsencrypt",
    "port": 3000
  },
  "hooks": {
    "install": [
      "mkdir -p /tmp/data",
      "python3 -m pip install -r requirements.txt -r requirements-dev.txt",
      "python3 -m pip install -e .",
      "(cd web && npm install)"
    ],
    "build": ["(cd web && npm run build)"]
  },
  "services": {
    "t1d-api": {
      "command": "uvicorn t1d_analytics.api:app --host 0.0.0.0 --port 8000",
      "env": {
        "T1D_DB_PATH": "/tmp/data/t1d_analytics.duckdb"
      }
    },
    "t1d-web": {
      "command": "cd web && npx vite preview --port 3000 --host",
      "env": {
        "NODE_ENV": "production"
      }
    }
  },
  "dependencies": {
    "required": {
      "servers": [
        {
          "name": "nginx",
          "daemon": {
            "os_native": true
          },
          "vars": {
            "NGINX_SERVER_NAME": "t1d-analytics.healthplatform.io",
            "PROXY_PASS": "http://127.0.0.1:3000",
            "LOCATION": "/"
          }
        }
      ],
      "toolchains": [
        {
          "name": "nodejs",
          "version": "20.x"
        },
        {
          "name": "python",
          "version": "3.12"
        },
        {
          "name": "duckdb",
          "version": "latest"
        },
        {
          "name": "ollama",
          "version": "latest"
        }
      ],
      "capabilities": ["systemd"]
    }
  }
}
