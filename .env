# Cloud & Remote Host Configuration
# Copy .env.secrets.tpl to .env.secrets for API keys, tokens, and private account identifiers.
CLOUD_PROVIDER=azure
DEFAULT_CLOUD_PROVIDER=azure
PRIMARY_CLOUD_PROVIDER=azure
GCP_PROVIDER=gcp
AWS_PROVIDER=aws
PRIMARY_CLOUD_CLI_NAME=az
PRIMARY_CLOUD_DISPLAY_NAME=Azure
PRIMARY_CLOUD_LOGIN_CMD="az login"
PRIMARY_CLOUD_VM_IMAGE=Ubuntu2404

# Compute & Network Configuration
NODE_NAME=test-t1d-analytics-node
NODE_SIZE=Standard_D16s_v7
RG_NAME=rg-analytics-test
LOCATION=eastus
REMOTE_DEST=t1d-analytics
REMOTE_USER=azureuser
REMOTE_GROUP=azureuser
REMOTE_HOME=/home/azureuser
REMOTE_APP_DIR=/home/azureuser/t1d-analytics
SERVICE_USER=azureuser
SERVICE_GROUP=azureuser
T1D_API_PORT=8001
T1D_WEB_PORT=3000

# Remote OS & Tool Paths
REMOTE_OS_CONDITION=linux
VOLTA_HOME=/home/azureuser/.volta
UV_BIN=uv
NPX_BIN=npx
SERVICE_PATH=/home/azureuser/.libscript/nodejs/22/bin:/home/azureuser/.libscript/nodejs/20/bin:/home/azureuser/.volta/bin:/home/azureuser/.local/bin:/root/.libscript/nodejs/22/bin:/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Storage & Database Paths
DATA_DISK_MOUNT=/mnt/data
TMP_DATA_DIR=/tmp/data
PRIMARY_BLOCK_DEVICE=/dev/nvme1n1
SECONDARY_BLOCK_DEVICE=/dev/disk/azure/scsi1/lun0
T1D_DB_PATH=/mnt/data/t1d_analytics.duckdb
T1D_DATA_DIR=/home/azureuser/t1d-analytics/data
T1D_SESSIONS_DB_PATH=/mnt/data/t1d_sessions.duckdb
OLLAMA_HOST=http://127.0.0.1:11434
